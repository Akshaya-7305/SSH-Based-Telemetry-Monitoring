import socket
import time

PC2_IP = "192.168.1.100"   # CHANGE this to PC2's IP address
PORT = 5000

while True:
    try:
        client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        client.connect((PC2_IP, PORT))

        message = "Hello World"
        client.send(message.encode())

        print("Sent:", message)

        client.close()

    except Exception as e:
        print("Error:", e)

    time.sleep(10)