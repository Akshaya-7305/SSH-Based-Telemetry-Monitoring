import os
from PIL import Image
from transformers import pipeline

HOST = "0.0.0.0"
PORT = 5000

print("Loading image identification model...")

classifier = pipeline(
    "image-classification",
    model="google/vit-base-patch16-224"
)

server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server.bind((HOST, PORT))
server.listen(1)

print("PC1 waiting for image...")

while True:

    connection, address = server.accept()

    print("\nImage connection from:", address)

    # Receive image
    with open("received.jpg", "wb") as image:
        while True:
            data = connection.recv(4096)

            if not data:
                break

            image.write(data)

    connection.close()

    print("Image received and saved.")

    # Open image
    image = Image.open("received.jpg")

    print("Image opened successfully.")
    print("Image size:", image.size)

    # Identify image
    result = classifier(image)

    print("\nImage Identification:")
    print("Object:", result[0]["label"])
    print("Confidence:",
          round(result[0]["score"] * 100, 2), "%")

    image.close()

    # Delete image
    os.remove("received.jpg")

    print("Image deleted.")
    print("Waiting for next image...")