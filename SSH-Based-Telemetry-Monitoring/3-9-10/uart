from machine import UART, Pin
import time

uart = UART(1, baudrate=9600, tx=Pin(14), rx=Pin(15))

print("Sending 10...")
uart.write(b"10\n")

time.sleep(1)

if uart.any():
    data = uart.readline()
    print("Received:", data)
else:
    print("NO RESPONSE")

PC2 - Arduino Nano (Arduino IDE)

void setup() {
  Serial.begin(9600);
}

void loop() {

  if (Serial.available()) {

    String received = Serial.readStringUntil('\n');
    received.trim();

    // Check whether Raspberry Pi sent 10
    if (received == "10") {

      Serial.println("TEN");
    }
  }
}

