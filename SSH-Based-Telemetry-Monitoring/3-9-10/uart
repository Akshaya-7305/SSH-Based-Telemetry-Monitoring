void setup() {
  Serial.begin(9600);
}

void loop() {
  if (Serial.available() > 0) {

    String data = Serial.readStringUntil('\n');
    data.trim();

    Serial.print("Received: ");
    Serial.println(data);

    if (data == "10") {
      Serial.println("TEN");
    }
  }
}