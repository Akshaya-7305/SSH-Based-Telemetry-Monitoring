PC1 — Raspberry Pi
from machine import UART, Pin
import time

# UART1
# GPIO14 = TX
# GPIO15 = RX
uart = UART(1, baudrate=9600, tx=Pin(14), rx=Pin(15))

# Send 10 to Arduino Nano
uart.write("10\n")

print("PC1 sent: 10")

# Wait for response from Nano
while not uart.any():
    time.sleep(0.1)

response = uart.readline()

if response:
    print("PC1 received:", response.decode().strip())

