STEP 5 — Create the sender program on PC1

Open Thonny on the Raspberry Pi.

Create a new file:

sender.py

Paste:

import socket
import os

PC2_IP = "192.168.10.2"
PORT = 5000

FILE_NAME = "program.py"

# Create a Python program to transfer
program = '''print("Hello from Raspberry Pi!")
print("File received successfully on PC2.")
print("The file was transferred byte by byte through Ethernet.")
'''

with open(FILE_NAME, "w") as file:
    file.write(program)

print("File created:", FILE_NAME)

# Create TCP socket
client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

print("Connecting to PC2...")
client.connect((PC2_IP, PORT))

print("Connected to PC2.")

# Send file name length
filename = os.path.basename(FILE_NAME).encode()
client.send(len(filename).to_bytes(2, "big"))

# Send file name
client.send(filename)

# Open file in binary mode
with open(FILE_NAME, "rb") as file:

    while True:
        byte = file.read(1)

        if not byte:
            break

        # Send exactly ONE BYTE
        client.send(byte)

print("File sent byte by byte.")

client.shutdown(socket.SHUT_WR)

# Receive confirmation
message = client.recv(1024).decode()

print(message)

client.close()

Save it.

⚠️ Don't run it yet.
