STEP 6 — Create receiver program on PC2

On your Windows PC, create a file called:

receiver.py

You can create it using Notepad.

Paste:

import socket
import subprocess

HOST = "0.0.0.0"
PORT = 5000

# Create TCP socket
server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

server.bind((HOST, PORT))
server.listen(1)

print("Waiting for PC1...")

connection, address = server.accept()

print("Connected to PC1:", address)

# Receive filename length
filename_length = int.from_bytes(connection.recv(2), "big")

# Receive filename
filename = connection.recv(filename_length).decode()

print("Receiving file:", filename)

received_file = "received_" + filename

# Receive the file byte by byte
with open(received_file, "wb") as file:

    byte_count = 0

    while True:

        byte = connection.recv(1)

        if not byte:
            break

        file.write(byte)
        byte_count += 1

print("File received successfully.")
print("Total bytes received:", byte_count)

connection.close()
server.close()

# Execute received Python file
print("\nExecuting received file...\n")

subprocess.run(["python", received_file])

print("\nProgram execution completed.")

Save it.
